<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
    <p><%= organizationDetails.description %></p>
    <p>Contact: <%= organizationDetails.contact_email %></p>
    <% if (user && user.role_name === 'admin') { %>
    <!-- Admin-only links or buttons -->
        <div class="action-group">
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="action-link secondary">Edit Organization</a>
        </div>
    <% } %>
    <h2>Service Projects</h2>
    <ul>
        <% for (const project of projects) { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>