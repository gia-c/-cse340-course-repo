<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= categoryDetails.name %></h2>
    <div class="action-group">
        <a href="/edit-category/<%= categoryDetails.category_id %>" class="action-link secondary">Edit Category</a>
    </div>
    <h2>Service Projects</h2>
    <ul>
        <% for (const project of projects) { %>
            <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>