<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= project.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <h2>Categories</h2>
    <ul class="tag-list">
        <% for (const category of categories) { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>