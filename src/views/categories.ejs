<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Explore our categories</h2>

        <% if (user && user.role_name === 'admin') { %>
        <!-- Admin-only links or buttons -->
        <div class="action-group">
            <a href="/new-category" class="action-link">+ Add New Category</a>
        </div>
        <% } %>
        
        <ul class="card-list">
            <% for (const category of categories) { %>
                <li class="card"><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% } %>
        </ul>
    </main>
<%- include('partials/footer') %>
