<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Explore our categories</h2>
        <ul class="card-list">
            <% for (const category of categories) { %>
                <li class="card"><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% } %>
        </ul>
    </main>
<%- include('partials/footer') %>
