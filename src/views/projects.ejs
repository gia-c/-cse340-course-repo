<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <% if (user && user.role_name === 'admin') { %>
            <!-- Admin-only links or buttons -->
            <div class="action-group">
                <a href="/new-project" class="action-link">+ Add New Project</a>
            </div>
        <% } %>
        <ul>
            <% for (const project of projects) { %>
                <li>
                    <strong><%= project.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></strong>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% } %>
        </ul>
    </main>
<%- include('partials/footer') %>